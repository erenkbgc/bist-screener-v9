<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>BIST Tarama Bulteni - {{ as_of_date }}</title>
<style>
  /* Temel Ayarlar ve Tipografi */
  body { margin:0; padding:0; background-color:#f3f4f6; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif; color:#374151; line-height:1.6; -webkit-font-smoothing:antialiased; }
  .wrap { max-width:740px; margin:0 auto; padding:24px 16px; }

  /* Ana Kartlar */
  .card { background-color:#ffffff; border:1px solid #e5e7eb; border-radius:12px; padding:28px; margin-bottom:24px; box-shadow:0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03); }

  /* Hero / Baslik Alani (Koyu Kurumsal Lacivert) */
  .hero { background:linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%); color:#ffffff; border-radius:12px; padding:32px 28px; margin-bottom:24px; box-shadow:0 10px 15px -3px rgba(15, 23, 42, 0.2); }
  .hero h1 { font-size:24px; font-weight:800; margin:0 0 8px; letter-spacing:-0.02em; }
  .hero .date { font-size:13px; color:#93c5fd; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:16px; }
  .hero .headline { font-size:15px; font-weight:400; color:#e0e7ff; line-height:1.6; margin:0; }

  /* Makro Etiketler (Pills) */
  .pillrow { margin-top:20px; display:flex; flex-wrap:wrap; gap:10px; }
  .pill { display:inline-flex; align-items:center; background-color:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.2); color:#ffffff; border-radius:6px; padding:6px 12px; font-size:12px; font-weight:600; letter-spacing:0.02em; backdrop-filter:blur(4px); }
  .pill.alert { background-color:rgba(239,68,68,0.2); border-color:rgba(239,68,68,0.4); color:#fca5a5; }

  /* Bolum Basliklari */
  .section-title { font-size:18px; font-weight:700; color:#111827; margin:0 0 4px; letter-spacing:-0.01em; }
  .section-sub { font-size:13px; color:#6b7280; margin:0 0 24px; font-weight:400; }

  /* Hisse Kartlari */
  .stock-card { border:1px solid #e5e7eb; border-radius:10px; padding:0; margin-bottom:20px; background:#ffffff; overflow:hidden; }
  .stock-card-inner { padding:24px; }
  .stock-head { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:20px; }
  .ticker { font-size:20px; font-weight:800; color:#111827; letter-spacing:0.02em; }

  /* Durum Etiketleri */
  .badge { display:inline-block; border-radius:6px; padding:4px 10px; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; }
  .badge-STRONG_OPPORTUNITY { background:#dcfce7; color:#14532d; }
  .badge-OPPORTUNITY { background:#dbeafe; color:#1e3a8a; }
  .badge-WATCHLIST { background:#fef3c7; color:#78350f; }
  .badge-NO_ACTION { background:#f3f4f6; color:#4b5563; }
  .badge-QUARANTINE { background:#fee2e2; color:#7f1d1d; }

  /* Veri Izgarasi (Terminal Stili) */
  .price-row { display:flex; flex-wrap:wrap; margin:0 0 20px; background:#f8fafc; border-radius:8px; border:1px solid #f1f5f9; padding:16px; }
  .price-box { flex:1; min-width:100px; border-right:1px solid #e2e8f0; padding-right:16px; margin-right:16px; }
  .price-box:last-child { border-right:none; padding-right:0; margin-right:0; }
  .price-box .lbl { font-size:11px; color:#64748b; font-weight:600; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:4px; }
  .price-box .val { font-size:20px; font-weight:700; color:#0f172a; line-height:1.2; }
  .price-box .val.up { color:#059669; }
  .price-box .val.down { color:#dc2626; }
  .live-tag { font-size:10px; color:#94a3b8; font-weight:500; margin-top:4px; }

  /* Yorum / Analiz Alanlari */
  .insight-box { margin-top:16px; border-radius:8px; font-size:13.5px; line-height:1.6; }
  .why { color:#334155; padding:16px; background-color:#f0f9ff; border-left:4px solid #3b82f6; border-radius:4px; margin-bottom:12px; }
  .risk { color:#7f1d1d; padding:16px; background-color:#fef2f2; border-left:4px solid #ef4444; border-radius:4px; }
  .why b, .risk b { color:#0f172a; font-weight:700; }

  /* Akordiyon (Detaylar) */
  details { margin-top:20px; border-top:1px solid #f1f5f9; padding-top:16px; }
  summary { cursor:pointer; font-size:13px; color:#475569; font-weight:600; outline:none; display:flex; align-items:center; }
  summary:hover { color:#0f172a; }
  summary::before { content:'+'; display:inline-block; margin-right:8px; font-size:16px; font-weight:400; color:#94a3b8; width:12px; }
  details[open] summary::before { content:'-'; }

  /* Minimalist Tablolar */
  table { width:100%; border-collapse:collapse; font-size:12.5px; margin:16px 0 8px; }
  th, td { text-align:left; padding:10px 4px; border-bottom:1px solid #f1f5f9; }
  th { color:#64748b; font-weight:600; font-size:11px; text-transform:uppercase; letter-spacing:0.05em; padding-bottom:12px; border-bottom:2px solid #e2e8f0; }
  td { color:#334155; }
  tr:last-child td { border-bottom:none; }

  /* Liste ve Yardimci Siniflar */
  ul { margin:12px 0; padding-left:20px; color:#475569; font-size:13px; }
  li { margin-bottom:6px; }
  .muted { color:#64748b; }
  .small { font-size:12px; color:#64748b; margin-top:8px; line-height:1.5; }
  .warn { color:#b45309; }
  .highlight { font-weight:600; color:#0f172a; }

  /* Deneysel / FCF Kutulari */
  .exp-box { border:1px dashed #cbd5e1; border-radius:6px; padding:14px; margin-top:16px; background:#f8fafc; }
  .empty-note { font-size:14px; color:#64748b; padding:24px; text-align:center; background:#f8fafc; border-radius:8px; border:1px solid #e2e8f0; }

  /* Footer */
  .footer { font-size:11px; color:#94a3b8; line-height:1.7; background:transparent; border:none; box-shadow:none; padding:0 12px; text-align:justify; margin-top:8px; }

  /* Mobil Düzenlemeler */
  @media (max-width:540px) {
    .wrap { padding:12px; }
    .card, .hero { padding:20px; }
    .price-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; border:none; background:transparent; padding:0; }
    .price-box { border-right:none; padding-right:0; margin-right:0; background:#f8fafc; padding:12px; border-radius:8px; border:1px solid #f1f5f9; }
    table, thead, tbody, th, td, tr { display:block; }
    th { display:none; }
    td { display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid #f1f5f9; }
    td:before { content: attr(data-label); font-weight:600; color:#64748b; font-size:11px; text-transform:uppercase; letter-spacing:0.02em; }
    td:last-child { text-align:right; }
  }
</style>
</head>
<body>
<div class="wrap">

  <!-- 1. Baslik Alanı -->
  <div class="hero">
    <h1>BIST Tarama Bulteni</h1>
    <div class="date">{{ as_of_date }}</div>
    <div class="headline">
      {% if no_action_today %}
        Bugun hard-filter'lardan gecen bir aday yok - sistem bilerek sessiz kaliyor, aksiyon onerilmiyor.
      {% elif regime_taxonomy_tag %}
        Rejim durumu: <span style="color:#ffffff; font-weight:700;">{{ regime_taxonomy_tag }}</span>. Asagida kisa ve uzun vade adaylarin ozeti yer almaktadir, teknik analiz detaylari hisse kartlarindaki "Detaylari Incele" bolumundedir.
      {% else %}
        Asagida kisa ve uzun vade adaylarin ozeti yer almaktadir, teknik analiz detaylari hisse kartlarindaki "Detaylari Incele" bolumundedir.
      {% endif %}
    </div>

    {% if regime %}
    <div class="pillrow">
      <span class="pill">Faiz %{{ regime.policy_rate_pct | fmt }}</span>
      <span class="pill">2Y Tahvil %{{ regime.bond_2y_pct | fmt }}</span>
      <span class="pill">TUFE %{{ regime.cpi_yoy_pct | fmt }}</span>
      <span class="pill">USD/TRY {{ regime.usdtry_spot | fmt }}</span>
      <span class="pill">XU100 {{ regime.xu100_level | fmt }}</span>
      {% if regime.short_selling_ban_active %}<span class="pill alert">Aciga Satis Yasagi Aktif</span>{% endif %}
    </div>
    {% endif %}
  </div>

  {% set price_source_label = {'live': 'Anlik', 'vwap_fallback': 'Hacim Ort. (VWAP)', 'last_close': 'Kapanis'} %}

  <!-- 2. Uzun Vade Adaylari -->
  <div class="card">
    <h2 class="section-title">Uzun Vade Onerileri</h2>
    <div class="section-sub">~6 aylik ufuk, sektor ici goreli degerlemeye dayali hedef fiyat hesabi.</div>

    {% if long_term_candidates %}
    {% for c in long_term_candidates %}
    <div class="stock-card">
      <div class="stock-card-inner">

        <div class="stock-head">
          <span class="ticker">{{ c.ticker }}</span>
          <span class="badge badge-{{ c.candidate_state }}">{{ c.candidate_state }}</span>
        </div>

        <div class="price-row">
          <div class="price-box">
            <div class="lbl">Guncel Fiyat</div>
            <div class="val">{{ c.current_price | fmt }}</div>
            <div class="live-tag">{{ price_source_label.get(c.price_source, c.price_source) }}</div>
          </div>
          <div class="price-box">
            <div class="lbl">Hedef Fiyat</div>
            <div class="val up">{{ c.target_price | fmt }}</div>
          </div>
          <div class="price-box">
            <div class="lbl">Beklenen Getiri</div>
            <div class="val up">%{{ c.expected_roi_pct | fmt }}</div>
          </div>
        </div>

        <div class="insight-box">
          <div class="why"><b>Neden:</b> {{ c.why_now }}</div>
          <div class="risk"><b>Ana Risk:</b> {{ c.main_risk }}</div>
        </div>

        {% if c.upcoming_events %}
        <div class="small" style="margin-top:16px;">
          <span class="highlight">Yaklasan Olaylar:</span>
          {% for ev in c.upcoming_events %}{{ ev.event_type }} ({{ ev.event_date }}){% if not loop.last %}; {% endif %}{% endfor %}
        </div>
        {% endif %}

        <details>
          <summary>Detaylari Incele</summary>
          <ul style="margin-top:12px;">{% for b in c.thesis_bullets %}<li>{{ b }}</li>{% endfor %}</ul>
          <div class="small" style="margin-bottom:16px; padding:12px; background:#f8fafc; border-radius:6px;">
            <span class="highlight">Bozulma Kosulu:</span> {{ c.invalidation_condition_display }}
          </div>

          <table>
            <tbody>
              <tr><td data-label="Metrik">Hurdle orani</td><td data-label="Deger">%{{ c.hurdle_rate_pct | fmt }}</td></tr>
              <tr><td data-label="Metrik">Hurdle uzeri fazla getiri</td><td data-label="Deger" class="highlight">%{{ c.excess_over_hurdle_pct | fmt }}</td></tr>
              <tr><td data-label="Metrik">Beta-duzeltmeli fazla</td><td data-label="Deger">%{{ c.excess_over_beta_hurdle_pct | fmt }}</td></tr>
              <tr><td data-label="Metrik">F-Score (Normalize)</td><td data-label="Deger">{{ c.piotroski_normalized_score | fmt }}</td></tr>
              <tr><td data-label="Metrik">Esler grubu</td><td data-label="Deger">{{ c.peer_group_used }} (n={{ c.peer_n }})</td></tr>
              <tr><td data-label="Metrik">Guven duzeyi</td><td data-label="Deger">{{ c.confidence }}</td></tr>
              <tr><td data-label="Metrik">Raporlama bazi</td><td data-label="Deger">{{ c.reporting_basis }}</td></tr>
              <tr><td data-label="Metrik">Tedbir seviyesi</td><td data-label="Deger">{{ c.tedbir_level | fmt }}</td></tr>
              <tr><td data-label="Metrik">Perakende payi</td><td data-label="Deger">%{{ c.retail_pct | fmt }}</td></tr>
              {% if c.net_expected_roi_pct is not none %}
              <tr><td data-label="Metrik">Net Getiri (Maliyet Sonrasi)</td><td data-label="Deger">%{{ c.net_expected_roi_pct | fmt }} <span class="muted">(Maliyet: %{{ c.transaction_cost_pct | fmt }})</span></td></tr>
              {% endif %}
            </tbody>
          </table>

          {% if c.sloan_flag %}
          <div class="small risk" style="margin-top:12px; padding:10px;">
            <b>Uyari:</b> elevated_earnings_quality_risk (peer_percentile: {{ c.sloan_peer_percentile | fmt }})
          </div>
          {% endif %}

          <div class="small" style="margin-top:12px;">FCF getirisi (USD bazli, bilgi amacli): %{{ c.fcf_yield_usd | fmt }}</div>

          {% if c.gordon %}
          <div class="exp-box">
            <div class="small highlight" style="margin-top:0;">Gordon Buyume Referansi (Deneysel, ana karara girmez)</div>
            {% if c.gordon.null_reason %}
            <div class="small muted" style="margin-top:4px;">Hesaplanamadi: {{ c.gordon.null_reason }}</div>
            {% else %}
            <div class="small" style="margin-top:4px;">Adil deger araligi: <b>{{ c.gordon.fair_value_low | fmt }} - {{ c.gordon.fair_value_high | fmt }}</b><br>
              <span class="muted">(Iskonto senaryolari: %{{ c.gordon.discount_rate_low | fmt }} / %{{ c.gordon.discount_rate_base | fmt }} / %{{ c.gordon.discount_rate_high | fmt }})</span></div>
            {% endif %}
          </div>
          {% endif %}
        </details>
      </div>
    </div>
    {% endfor %}
    {% else %}
    <div class="empty-note">Bugun icin uzun vade adayi bulunmuyor.</div>
    {% endif %}
  </div>

  <!-- 3. Kisa Vade Adaylari -->
  <div class="card">
    <h2 class="section-title">Kisa Vade Onerileri</h2>
    <div class="section-sub">~20 gunluk ufuk, hacim teyitli teknik kirilim. "Giris seviyesi" 20 gunluk ortalamaya cekilme bazalidir.</div>

    {% if short_term_candidates %}
    {% for c in short_term_candidates %}
    <div class="stock-card">
      <div class="stock-card-inner">

        <div class="stock-head">
          <span class="ticker">{{ c.ticker }}</span>
          <span class="badge badge-{{ c.candidate_state }}">{{ c.candidate_state }}</span>
        </div>

        <div class="price-row">
          <div class="price-box">
            <div class="lbl">Guncel Fiyat</div>
            <div class="val">{{ c.current_price | fmt }}</div>
            <div class="live-tag">{{ price_source_label.get(c.price_source, c.price_source) }}</div>
          </div>
          <div class="price-box">
            <div class="lbl">Giris (Pullback)</div>
            <div class="val">{{ c.entry_price | fmt }}</div>
          </div>
          <div class="price-box">
            <div class="lbl">ATR Hedefi</div>
            <div class="val up">{{ c.target_price | fmt }}</div>
          </div>
          <div class="price-box">
            <div class="lbl">Stop-Loss</div>
            <div class="val down">{{ c.stop_loss | fmt }}</div>
          </div>
        </div>

        <details>
          <summary>Detaylari Incele</summary>
          <table>
            <tbody>
              <tr><td data-label="Metrik">Hacim teyidi (20g orani)</td><td data-label="Deger">{{ c.volume_ratio_20d | fmt }}</td></tr>
              <tr><td data-label="Metrik">Hurdle uzeri fazla</td><td data-label="Deger" class="highlight">%{{ c.excess_over_hurdle_pct | fmt }}</td></tr>
              <tr><td data-label="Metrik">Katalizor skoru</td><td data-label="Deger">{{ c.catalyst_score | fmt }}</td></tr>
              <tr><td data-label="Metrik">Guven duzeyi</td><td data-label="Deger">{{ c.confidence }}</td></tr>
              {% if c.net_expected_roi_pct is not none %}
              <tr><td data-label="Metrik">Net Getiri (Maliyet Sonrasi)</td><td data-label="Deger">%{{ c.net_expected_roi_pct | fmt }} <span class="muted">(Maliyet: %{{ c.transaction_cost_pct | fmt }})</span></td></tr>
              {% endif %}
            </tbody>
          </table>
        </details>
      </div>
    </div>
    {% endfor %}
    {% else %}
    <div class="empty-note">Bugun icin kisa vade adayi bulunmuyor.</div>
    {% endif %}
  </div>

  <!-- 4. Ne Degisti + Yogunlasma Uyarisi -->
  {% if decision_diff.entered or decision_diff.exited or decision_diff.catalyst_deltas or decision_diff.macro_deltas or concentration_warnings %}
  <div class="card">
    <h2 class="section-title">Gunluk Degisimler</h2>
    <div style="margin-top:16px;">
      {% if decision_diff.entered %}
      <div class="small"><span class="highlight">Portfoye Yeni Giren:</span> {{ decision_diff.entered | join(', ') }}</div>
      {% endif %}

      {% if decision_diff.exited %}
      <div class="small"><span class="highlight">Portfoyden Cikan:</span> {{ decision_diff.exited | join(', ') }}</div>
      {% endif %}

      {% if decision_diff.catalyst_deltas %}
      <div class="small" style="margin-top:12px;"><span class="highlight">Yeni KAP Olaylari:</span><br>
        {% for e in decision_diff.catalyst_deltas %}&bull; {{ e.ticker }} ({{ e.category }} : {{ e.published_at }}){% if not loop.last %}<br>{% endif %}{% endfor %}
      </div>
      {% endif %}

      {% if decision_diff.macro_deltas %}
      <div class="small" style="margin-top:12px;"><span class="highlight">Makro Degisim:</span>
        {% for m in decision_diff.macro_deltas %}{{ m.field }}: {{ m.from | fmt }} &rarr; {{ m.to | fmt }}{% if not loop.last %}; {% endif %}{% endfor %}
      </div>
      {% endif %}

      {% if concentration_warnings %}
      <div style="margin-top:16px; padding:12px; background:#fffbeb; border-left:4px solid #f59e0b; border-radius:4px;">
        <div class="small highlight" style="color:#b45309; margin-top:0;">Yogunlasma Uyarilari:</div>
        <ul style="margin:4px 0 0; color:#92400e;">
          {% for w in concentration_warnings %}<li>{{ w.message }}</li>{% endfor %}
        </ul>
      </div>
      {% endif %}
    </div>
  </div>
  {% endif %}

  <!-- 5. Bozulan Tezler -->
  {% if invalidation_triggered %}
  <div class="card">
    <h2 class="section-title" style="color:#991b1b;">Bozulan Tezler</h2>
    <div class="small muted" style="margin-bottom:16px;">Asagidakiler dogrudan bir SATIS SINYALI degildir, portfoy izleme (durum) bildirimidir.</div>
    <ul style="margin:0; padding:0; list-style:none;">
    {% for t in invalidation_triggered %}
      <li class="small" style="padding:12px 16px; background:#fef2f2; border:1px solid #fee2e2; border-radius:6px; margin-bottom:8px; color:#7f1d1d;">
        <b style="font-size:13px;">{{ t.ticker }}</b>: {{ t.condition_field }} {{ t.condition_operator }} {{ t.condition_value }} kosulu tetiklendi (Guncel: {{ t.current_value }})
      </li>
    {% endfor %}
    </ul>
  </div>
  {% endif %}

  <!-- 6. Gecmis Tahmin Izleme Ozeti -->
  {% if evaluation_summary %}
  <div class="card">
    <h2 class="section-title">Gecmis Tahmin Izleme Ozeti</h2>
    <div class="small muted" style="margin-bottom:16px;">Bu canli bir takip ozetidir (Backtest degildir). Gecmis performans gelecekteki sonuclari garanti etmez. {{ evaluation_summary.independence_caveat }}</div>
    <table>
      <thead>
        <tr>
          <th>Ufuk (Gun)</th>
          <th>Gozlem Sayisi</th>
          <th>Isabet Orani</th>
          <th>Medyan Fazla Getiri (Endekse gore)</th>
        </tr>
      </thead>
      <tbody>
      {% for horizon, s in evaluation_summary.by_horizon.items() %}
        {% if s %}
        <tr>
          <td data-label="Ufuk">{{ horizon }}</td>
          <td data-label="Gozlem Sayisi">{{ s.n_observations | fmt }}</td>
          <td data-label="Isabet Orani" class="highlight">%{{ s.hit_rate_pct | fmt }}</td>
          <td data-label="Fazla Getiri">%{{ s.median_excess_vs_index | fmt }}</td>
        </tr>
        {% endif %}
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <!-- 7. Filtreye Takilanlar -->
  <div class="card" style="padding:20px 28px;">
    <details style="margin:0; border:none; padding:0;">
      <summary style="font-size:14px; font-weight:700;">Filtreye takilan / Skorlanamayan Hisseler ({{ no_action_count | fmt }} + {{ unscored_count | fmt }})</summary>
      <div class="muted small" style="margin:12px 0 16px;">{{ unscored_count }} adet hisse bu kosuda skorlanamadi (eksik veri, baz belirsizligi veya yetersiz esler grubu).</div>
      {% if filtered_candidates %}
      <table>
        <thead><tr><th>Ticker</th><th>Filtrelenme Nedeni</th></tr></thead>
        <tbody>
          {% for c in filtered_candidates %}
          <tr><td data-label="Ticker" class="highlight">{{ c.ticker }}</td><td data-label="Neden">{{ c.filtered_by }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}
    </details>
  </div>

  <!-- 8. Metodoloji & Yasal Uyari (Footer) -->
  <div class="footer">
    <p>final_score = {{ weights.valuation_z | fmt }} x valuation_z + {{ weights.catalyst_score | fmt }} x catalyst_score + {{ weights.ownership_quality_z | fmt }} x ownership_quality_z + {{ weights.low_vol_z | fmt }} x low_vol_z. Piotroski esigi: {{ weights.piotroski_normalized_score_threshold | fmt }}, ERP (Equity Risk Premium): %{{ weights.equity_risk_premium_pct | fmt }}. Bu agirliklar ve esikler DENENMEMIS BASLANGIC VARSAYIMLARIDIR; hicbir gecmis veriyle kalibre edilmemistir.</p>
    <div style="border-top:1px solid #cbd5e1; margin:16px 0 12px; width:40px;"></div>
    <p>{{ disclaimer_text }}</p>
  </div>

</div>
</body>
</html>
