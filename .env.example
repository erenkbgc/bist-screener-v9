# delivery.required_env (spec) - SMTP ile gonderim icin gereklidir.
# Bu degiskenler bos birakilirsa run.py rapor HTML'ini data/reports/ altina
# yazar ve e-posta GONDERMEZ (bkz. run.py::_dispatch).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=
MAIL_FROM=

# BIST_DATA_MODE: "mock" (varsayilan, testlerde de budur, deterministik sahte
# veri) veya "live" (core/live_data.py -> borsapy/Is Yatirim/doviz.com kaynakli
# GERCEK veri, TUM BIST evreni ~800 sirket, hardcoded ticker yok). bkz. README.
BIST_DATA_MODE=mock

# Yalnizca gelistirme/hizli-test icin: live modda evreni ilk N kayitla sinirlar
# (dinamik olarak cekilen listenin bir dilimi, hardcoded sembol degil).
# Production'da BOS birakin (tum evren taranir).
BIST_LIVE_UNIVERSE_LIMIT=
